{
  "name": "@gss-l/vite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": ["client.d.ts", "dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/consumer/tsconfig.json --noEmit && tsc -p test/without-client/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gss-l/types": "workspace:*",
    "@gss-l/compiler": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@gss-l/react": "workspace:*",
    "@types/node": "^22.20.4",
    "vite": "^7.3.6"
  }
}
