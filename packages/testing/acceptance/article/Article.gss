.page { max-width: 820px; margin: 0 auto; padding: 28px 20px; background-color: #fffefb; color: #293d38; font-family: system-ui, sans-serif; font-size: 16px; line-height: 1.8; letter-spacing: 0.2px; overflow-wrap: anywhere; }
.page[data-size="large"] { font-size: 20px; line-height: 1.9; letter-spacing: 0.6px; }
.page[data-tone="warm"] { color: #674536; background-color: #fff8e9; }
.header { padding-bottom: 24px; border-bottom: 1px solid #d8ded4; }
.kicker { margin: 0 0 12px; color: #587269; font-size: 12px; font-weight: 700; letter-spacing: 2px; }
.title { margin: 0; font-size: 30px; line-height: 1.4; letter-spacing: -0.5px; }
.meta { margin: 12px 0 0; color: #587269; font-size: 13px; line-height: 1.6; letter-spacing: 0; }
.toolbar { display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 28px; }
.button { padding: 8px 12px; border: 1px solid #a6b9ac; border-radius: 8px; color: #305346; background-color: #ffffff; font-family: inherit; font-size: 13px; font-weight: 650; line-height: 1.5; letter-spacing: 0; cursor: pointer; }
.button:hover { border-color: #527c64; }
.button:focus-visible { outline: 3px solid #527c64; outline-offset: 2px; }
.button:disabled { opacity: 0.45; cursor: default; }
.button[aria-pressed="true"] { background-color: #dfeee3; }
.body { display: grid; gap: 20px; }
.paragraph { margin: 0; }
.sectionTitle { margin: 0; font-size: 1.2em; line-height: 1.5; }
.link { color: #266b62; text-decoration: underline; }
.link:focus-visible { outline: 3px solid #527c64; outline-offset: 2px; }
.ordered { margin: 0; padding-left: 32px; list-style-type: decimal; list-style-position: outside; }
.unordered { margin: 12px 0 0; padding-left: 28px; list-style-type: disc; list-style-position: outside; }
.item { padding-left: 4px; margin-bottom: 8px; }
.item::marker { color: #96603f; font-weight: 700; }
.quote { margin: 0; padding: 16px 20px; border-left: 4px solid #7c9b85; background-color: #edf3eb; }
.quote::before { content: "「"; color: #527c64; font-size: 1.4em; font-weight: 700; }
.quote::after { content: "」"; color: #527c64; font-size: 1.4em; font-weight: 700; }
.note { margin: 0; padding: 12px 16px; background-color: #f3ede2; color: #735433; font-size: 14px; line-height: 1.7; letter-spacing: 0; }
.comments { margin-top: 32px; padding-top: 24px; border-top: 1px solid #d8ded4; }
.commentsHeading { margin: 20px 0 16px; font-size: 1.2em; line-height: 1.5; }
.commentsHeading:focus-visible { outline: 3px solid #527c64; outline-offset: 2px; }
.comment { padding: 16px 0; border-bottom: 1px solid #d8ded4; }
.author { margin: 0 0 8px; color: #305346; font-size: 14px; font-weight: 700; letter-spacing: 0; }
.actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.reply { margin: 12px 0 0 16px; padding: 12px 16px; border-left: 2px solid #a6b9ac; background-color: #f1f5ef; }
.form { display: grid; gap: 12px; margin-top: 16px; padding: 16px; border: 1px solid #a6b9ac; border-radius: 12px; background-color: #f1f5ef; }
.label { display: grid; gap: 8px; font-size: 14px; font-weight: 650; }
.field { width: 100%; min-width: 0; padding: 10px; border: 1px solid #a6b9ac; border-radius: 8px; background-color: #ffffff; color: #293d38; font-family: inherit; font-size: 16px; font-weight: 400; line-height: 1.6; letter-spacing: 0; }
.field:focus-visible { outline: 3px solid #527c64; outline-offset: 2px; }
.field::placeholder { color: #687c73; }
.notice { margin: 12px 0 0; color: #587269; font-size: 13px; line-height: 1.6; letter-spacing: 0; }
