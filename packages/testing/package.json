{
  "name": "@gss-l/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p playground/tsconfig.json",
    "browser:reference": "vite browser --host 127.0.0.1 --port 4178 --strictPort",
    "browser:check": "node browser/check.mjs",
    "playground": "vite playground",
    "playground:build": "vite build playground",
    "playground:preview": "vite preview playground",
    "playground:check": "node playground/check.mjs"
  },
  "dependencies": {
    "postcss": "^8.4.49",
    "postcss-selector-parser": "^7.0.0"
  },
  "devDependencies": {
    "@gss-l/compiler": "workspace:*",
    "@gss-l/react": "workspace:^",
    "@gss-l/vite": "workspace:^",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "1.58.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.3.6"
  }
}
