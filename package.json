{
  "name": "gss-l",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.6.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm -r --sort --if-present run build",
    "lint": "eslint .",
    "test": "pnpm -r --sort --if-present run test",
    "typecheck": "pnpm -r --sort --if-present run typecheck",
    "verify": "pnpm lint && pnpm build && pnpm test && pnpm typecheck",
    "framework-ssr:check": "pnpm build && pnpm --filter @gss-l/testing framework-ssr:check",
    "vite-template:check": "pnpm build && pnpm --filter @gss-l/testing vite-template:check",
    "playground": "pnpm build && pnpm --filter @gss-l/testing playground",
    "playground:build": "pnpm build && pnpm --filter @gss-l/testing playground:build",
    "playground:preview": "pnpm --filter @gss-l/testing playground:preview",
    "playground:check": "pnpm build && pnpm --filter @gss-l/testing playground:check",
    "task-board": "pnpm build && pnpm --filter @gss-l/testing task-board",
    "task-board:build": "pnpm build && pnpm --filter @gss-l/testing task-board:build",
    "task-board:check": "pnpm build && pnpm --filter @gss-l/testing task-board:check",
    "article": "pnpm build && pnpm --filter @gss-l/testing article",
    "article:build": "pnpm build && pnpm --filter @gss-l/testing article:build",
    "article:check": "pnpm build && pnpm --filter @gss-l/testing article:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
