.panel { display: grid; gap: 16px; padding: 24px; border: 1px solid #b5c9bd; border-left: 4px solid #387459; border-radius: 16px; background-color: #edf5ef; }
.heading { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; align-items: center; }
.title { font-size: 22px; font-weight: 700; overflow-wrap: anywhere; }
.meta { font-size: 13px; color: #456451; }
.copy { max-width: 720px; color: #385443; white-space: pre-wrap; overflow-wrap: anywhere; }
.close { border: 1px solid #aabfb2; border-radius: 8px; padding: 8px 12px; background-color: white; color: #28513e; }
.close:hover { background-color: #e8f0eb; }
.close:focus-visible { outline: 3px solid #46785c; outline-offset: 2px; }
